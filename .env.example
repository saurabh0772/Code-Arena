# CodeArena Root Environment Variables (Docker Compose / Local Deployment)
# Copy to .env and configure before running docker compose

# Required: JWT signing secret (minimum 32 characters recommended)
JWT_SECRET=

# Optional: Shared workspace directory for Docker-outside-of-Docker execution
CODEARENA_WORKSPACE_BASE=/tmp/codearena-workspaces
CODEARENA_HOST_WORKSPACE_DIR=/tmp/codearena-workspaces
