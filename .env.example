# ==============================================================================
# CodeArena Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and configure for your environment.
# DO NOT commit the actual .env file with production credentials to Git.
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=5000

# Database Configuration
# In Docker Compose: mongodb://mongodb:27017/codearena
# Standalone Local: mongodb://localhost:27017/codearena
MONGODB_URI=mongodb://mongodb:27017/codearena

# Redis & Queue Configuration (Phase 13: Redis + Queue)
# In Docker Compose: redis
# Standalone Local: localhost
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379

# Phase 17: Distributed Worker Configuration
# WORKER_ID=                     # Optional override; auto-generated if unset
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
WORKER_STALE_TIMEOUT_MS=30000     # Threshold for stale RUNNING submission recovery (30s)

# Authentication & Security
# REQUIRED in production: Cryptographically secure secret (>= 32 characters)
JWT_SECRET=codearena-dev-local-secret-key-32charsmin!
JWT_EXPIRES_IN=1d

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Do NOT use '*' in production.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Execution Engine & Docker Sandbox
# 'docker' (mandatory default for security) | 'local' (host execution, strictly opt-in dev/test)
EXECUTION_MODE=docker
CODEARENA_SANDBOX_IMAGE=codearena-sandbox:v1
CODEARENA_WORKSPACE_BASE=/tmp/codearena-workspaces
CODEARENA_HOST_WORKSPACE_DIR=/tmp/codearena-workspaces

# Observability & Logging
# 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=debug

# Rate Limiting Controls
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SUBMISSION_MAX=10
