      "id": 1,
      "title": "API Gateway & HTTP Traffic Overview",
      "type": "row"
    },
    {
      "id": 2,
      "title": "HTTP Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(codearena_http_requests_total[1m])) by (status)",
          "legendFormat": "Status {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 / P99 HTTP Latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(codearena_http_request_duration_seconds_bucket[1m])) by (le, method, route))",
          "legendFormat": "P95 {{method}} {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(codearena_http_request_duration_seconds_bucket[1m])) by (le, method, route))",
          "legendFormat": "P99 {{method}} {{route}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Submissions & Execution Telemetry",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Submission Rate by Verdict",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
